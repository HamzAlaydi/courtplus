# App
NODE_ENV=development
PORT=3000
APP_NAME=
APP_LOGO_URL=
FRONTEND_URL=
COURT_PLUS_PERCENTAGE=0.2

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# Database (PostgreSQL + PostGIS)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=courtplus

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Twilio Verify (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# AWS (S3 uploads, SES email, Rekognition moderation, CloudFront CDN)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_CDN_URL=
CLOUDFRONT_DISTRIBUTION_ID=
SES_FROM_EMAIL=
# Inbox that receives website contact form messages (defaults to SES_FROM_EMAIL)
CONTACT_INBOX_EMAIL=

# Firebase Admin (FCM push + social login verification)
# FIREBASE_PRIVATE_KEY must be the PEM private key, base64-encoded
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=

# Google Maps (Places / Geocoding)
GOOGLE_MAPS_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTIONS_WEBHOOK_SECRET=
# Two Stripe endpoints point at /webhooks/payouts/stripe: a Connect one (account.updated)
# and a platform one (transfer.created/reversed). Each has its own signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PAYOUTS_WEBHOOK_SECRET=
# ISO country used when a vendor starts Stripe Connect onboarding without picking one
PAYOUTS_DEFAULT_COUNTRY=SA
STRIPE_BRANCH_PRODUCT_ID=
STRIPE_BRANCH_PRICE_ID=

# Mail driver: smtp (Gmail, any recipient) or ses (AWS, needs prod access)
MAIL_DRIVER=
SMTP_USER=
SMTP_PASS=
STRIPE_BRANCH_ADDON_PRICE_ID=
STRIPE_COURT_ADDON_PRICE_ID=

# --- Added during production hardening ---
# Comma-separated browser origins allowed to call the API (mobile sends no Origin).
CORS_ORIGINS=https://dashboard.courtplusapp.com,https://ops.courtplusapp.com,https://courtplusapp.com
# Serve Swagger at /reference/api. MUST stay false in production.
ENABLE_API_DOCS=false
# Local-only OTP bypass. Boot fails if this is set while NODE_ENV=production.
DEV_OTP_BYPASS_CODE=
# Pre-launch testing: every phone number signs in to the app with this 6-digit
# code and no SMS is sent (phone OTP only). Allowed in production — remove it
# before real customers sign up.
TEST_PHONE_OTP_CODE=
# Stripe Connect endpoint signing secret (was read at runtime but never validated).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional: error tracking.
SENTRY_DSN=
# Postgres tuning
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
