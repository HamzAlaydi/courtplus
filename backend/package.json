{
  "name": "court-plus",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli",
    "migration:run": "npm run typeorm migration:run -- -d ./ormconfig.db.ts",
    "migration:generate": "npm run typeorm -- -d ./ormconfig.db.ts migration:generate ./src/migrations/$npm_config_name",
    "migration:create": "npm run typeorm -- migration:create ./src/migrations/$npm_config_name",
    "migration:revert": "npm run typeorm -- -d ./ormconfig.db.ts migration:revert",
    "stripe:confirm": "stripe payment_intents confirm $npm_config_pi --payment-method pm_card_visa",
    "stripe:listen:payments": "stripe listen --events charge.succeeded,charge.failed,payment_intent.succeeded,payment_intent.payment_failed,charge.refunded --forward-to localhost:3000/payments/stripe",
    "stripe:listen:subscriptions": "stripe listen --events checkout.session.completed,checkout.session.expired,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed --forward-to localhost:3000/subscriptions/webhook",
    "stripe:listen:connect": "stripe listen --events transfer.created,transfer.reversed,account.updated --forward-to localhost:3000/webhooks/payouts/stripe --forward-connect-to localhost:3000/webhooks/payouts/stripe"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.799.0",
    "@aws-sdk/client-rekognition": "^3.799.0",
    "@aws-sdk/client-s3": "^3.821.0",
    "@aws-sdk/client-sesv2": "^3.812.0",
    "@aws-sdk/s3-presigned-post": "^3.821.0",
    "@aws-sdk/s3-request-presigner": "^3.821.0",
    "@better-auth/utils": "^0.2.4",
    "@keyv/redis": "^4.4.0",
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@noble/hashes": "^1.8.0",
    "@react-email/components": "^0.0.38",
    "bullmq": "^5.52.1",
    "cache-manager": "^6.4.2",
    "cacheable": "^1.8.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "firebase-admin": "^13.3.0",
    "geojson": "^0.5.0",
    "helmet": "^8.1.0",
    "i18next": "^25.2.1",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "keyv": "^5.3.3",
    "libphonenumber-js": "^1.12.7",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.11",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.3",
    "passport-jwt": "^4.0.1",
    "pg": "^8.15.6",
    "react": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^18.1.0",
    "twilio": "^5.5.2",
    "typeorm": "^0.3.22",
    "typeorm-transactional": "^0.5.0",
    "unique-username-generator": "^1.4.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "xstate": "^5.24.0"
